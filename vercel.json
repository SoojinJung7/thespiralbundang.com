{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "buildCommand": "",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    { "source": "/forum", "destination": "/", "permanent": true },
    { "source": "/forum/:path*", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/general-8", "destination": "/category/gyrotonic-pre-training", "permanent": true }
  ],
  "headers": [
    { "source": "/m/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
